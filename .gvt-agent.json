{
  "project": {
    "name": "audit-core",
    "description": "Shared audit mechanism for the gvt-dev and gvt-construct3 convention audits",
    "languages": ["javascript", "typescript"]
  },
  "commands": {
    "test": "npm test",
    "lint": "npm run lint",
    "build": "npm run build",
    "validate": "npm run lint && npm run typecheck && npm test"
  },
  "repo": {
    "host": "github",
    "default_branch": "main"
  },
  "bugTracker": {
    "kind": "github",
    "actionQuery": "gh issue list --state open -L 200 --json number,title,labels,body,assignees,author,createdAt",
    "comparisonQuery": "gh issue list --state all -L 500 --json number,title,labels,state",
    "readOne": "gh issue view {id} --json number,title,body,labels,comments",
    "triagedLabel": "triaged",
    "needsInfoLabel": "question"
  },
  "wiki": {
    "wikiDir": "wiki",
    "rawDir": "raw"
  },
  "features": {},
  "paths": {}
}
